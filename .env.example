# Copy to .env.local for local development (never commit .env.local).
# Firebase Web SDK config (Console → Project settings → Your apps).

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Optional: comma-separated Firebase Auth UIDs allowed to see admin tools in Profile.
# When unset, legacy client checks apply. Server-side Firestore rules must still restrict writes.
# REACT_APP_ADMIN_UIDS=
